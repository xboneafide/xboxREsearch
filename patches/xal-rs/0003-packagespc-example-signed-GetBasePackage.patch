+//! Signed request against packagespc.xboxlive.com GetBasePackage
+//!
+use env_logger::Env;
+use xal::{
+    cvlib::CorrelationVector,
+    extensions::{
+        CorrelationVectorReqwestBuilder, LoggingReqwestRequestHandler,
+        LoggingReqwestResponseHandler, SigningReqwestBuilder,
+    },
+    Error, RequestSigner, TokenStore, XalAuthenticator,
+};
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    env_logger::Builder::from_env(Env::default().default_filter_or("info")).init();
+    let args: Vec<String> = std::env::args().collect();
+    let token_path = args.get(1).cloned().unwrap_or_else(|| "tokens.json".into());
+    let cid = args.get(2).cloned().expect("usage: packagespc <tokenfile> <content-id>");
+    let rp = args
+        .get(3)
+        .cloned()
+        .unwrap_or_else(|| "http://update.xboxlive.com".into());
+
+    let token_store = TokenStore::load_from_file(&token_path)?;
+    let mut auth = XalAuthenticator::from(token_store.clone());
+
+    let device = token_store.device_token.clone();
+    let title = token_store.title_token.clone();
+    let user = token_store.user_token.clone();
+
+    // Fresh XSTS for the requested relying party (default: update.xboxlive.com)
+    let xsts_token = auth
+        .get_xsts_token(device.as_ref(), title.as_ref(), user.as_ref(), rp.as_str())
+        .await?;
+    println!("xsts ok for RP {}", rp);
+
+    let mut cv = CorrelationVector::new();
+    let mut signer = RequestSigner::new();
+
+    let url = format!("https://packagespc.xboxlive.com/GetBasePackage/{}", cid);
+    let resp = reqwest::Client::new()
+        .get(&url)
+        .header("x-xbl-contract-version", "1")
+        .header("Accept", "application/json")
+        .header("Authorization", xsts_token.authorization_header_value())
+        .add_cv(&mut cv)?
+        .sign(&mut signer, None)
+        .await?
+        .log()
+        .await?
+        .send()
+        .await?
+        .log()
+        .await?;
+
+    let text = resp.text().await?;
+    println!("{}", text);
+    Ok(())
+}
