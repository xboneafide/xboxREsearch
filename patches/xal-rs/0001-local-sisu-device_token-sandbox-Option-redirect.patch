--- a/src/models.rs
+++ b/src/models.rs
@@ -396,7 +396,10 @@ pub mod response {
     #[serde(rename_all = "PascalCase")]
     pub struct SisuAuthorizationResponse {
         /// Device Token
-        pub device_token: String,
+        /// NOTE: field is optional — the retail sisu /authorize endpoint omits it
+        /// when the device token was already issued at the /authenticate step.
+        #[serde(default)]
+        pub device_token: Option<String>,
         /// Title Token
         pub title_token: TitleToken,
         /// User Token
@@ -406,7 +409,9 @@ pub mod response {
         /// Web page
         pub web_page: String,
         /// Xbox Live sandbox
-        pub sandbox: String,
+        /// NOTE: retail sisu /authorize omits this field too — make it optional.
+        #[serde(default)]
+        pub sandbox: Option<String>,
         /// Modern gamertag indication
         pub use_modern_gamertag: Option<bool>,
     }
