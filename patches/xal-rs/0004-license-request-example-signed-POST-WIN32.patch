+//! Signed XBL3.0 request against licensing.mp.microsoft.com /licenses/content
+//! with an XSTS token for the http://licensing.xboxlive.com relying party.
+//!
+//! usage: licreq <tokenfile> <request-body-json-file> [url] [rp]
+use env_logger::Env;
+use xal::{
+    cvlib::CorrelationVector,
+    extensions::{
+        CorrelationVectorReqwestBuilder, LoggingReqwestRequestHandler,
+        LoggingReqwestResponseHandler, SigningReqwestBuilder,
+    },
+    Error, RequestSigner, TokenStore, XalAuthenticator,
+};
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    env_logger::Builder::from_env(Env::default().default_filter_or("info")).init();
+    let args: Vec<String> = std::env::args().collect();
+    let token_path = args.get(1).cloned().unwrap_or_else(|| "tokens.json".into());
+    let body_path = args.get(2).cloned().expect("usage: licreq <tokenfile> <body.json> [url] [rp]");
+    let url = args
+        .get(3)
+        .cloned()
+        .unwrap_or_else(|| "https://licensing.mp.microsoft.com/v7.0/licenses/content".into());
+    let rp = args
+        .get(4)
+        .cloned()
+        .unwrap_or_else(|| "http://licensing.xboxlive.com".into());
+
+    let token_store = TokenStore::load_from_file(&token_path)?;
+    let mut auth = XalAuthenticator::from(token_store.clone());
+    let device = token_store.device_token.clone();
+    let title = token_store.title_token.clone();
+    let user = token_store.user_token.clone();
+
+    let xsts_token = auth
+        .get_xsts_token(device.as_ref(), title.as_ref(), user.as_ref(), rp.as_str())
+        .await?;
+    println!("xsts ok for RP {}", rp);
+
+    // PATCH: dump XSTS JWT claims for inspection
+    let jwt = xsts_token.token.split('.').nth(1).unwrap_or("");
+    // tiny urlsafe-base64 decoder (no padding)
+    let mut b64 = jwt.replace(['-', '_'], "+");
+    while b64.len() % 4 != 0 { b64.push('='); }
+    let claim_str = {
+        use std::io::Write;
+        // decode via base64 to hex-free approach: reuse xal's BASE64 through... simplest: manual
+        let mut out = Vec::new();
+        let table: &[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+        let mut buf: u32 = 0;
+        let mut bits = 0;
+        for c in b64.bytes() {
+            if c == b'=' { break; }
+            if let Some(v) = table.iter().position(|&t| t == c) {
+                buf = (buf << 6) | v as u32;
+                bits += 6;
+                if bits >= 8 {
+                    bits -= 8;
+                    out.push(((buf >> bits) & 0xFF) as u8);
+                }
+            }
+        }
+        String::from_utf8(out).unwrap_or_default()
+    };
+    println!("XSTS claims: {}", claim_str);
+
+    let body = std::fs::read_to_string(&body_path)?;
+
+    let mut cv = CorrelationVector::new();
+    let mut signer = RequestSigner::new();
+
+    let resp = reqwest::Client::new()
+        .post(&url)
+        .header("x-xbl-contract-version", "1")
+        .header("Accept", "application/json")
+        .header("Content-Type", "application/json; charset=utf-8")
+        .header("From", "XboxLicenseManager")
+        .header(
+            "User-Agent",
+            "XboxLm-PC/Microsoft.GamingServices_39.118.21002.0_x64__8wekyb3d8bbwe",
+        )
+        .header("Authorization", xsts_token.authorization_header_value())
+        .body(body)
+        .add_cv(&mut cv)?
+        .sign(&mut signer, None)
+        .await?
+        .log()
+        .await?
+        .send()
+        .await?
+        .log()
+        .await?;
+
+    let status = resp.status();
+    let text = resp.text().await?;
+    println!("HTTP {}", status);
+    println!("{}", text);
+    Ok(())
+}
