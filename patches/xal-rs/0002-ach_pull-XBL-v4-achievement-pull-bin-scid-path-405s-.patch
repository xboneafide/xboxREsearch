+//! Pull full XBL achievement lists (v4) for a set of SCIDs, with request signing.
+//! Usage: ach_pull.exe <scid1> <scid2> ...   (reads tokens.json next to CWD)
+use xal::{
+    cvlib::CorrelationVector,
+    extensions::{
+        CorrelationVectorReqwestBuilder, LoggingReqwestRequestHandler,
+        LoggingReqwestResponseHandler, SigningReqwestBuilder,
+    },
+    Error, RequestSigner, TokenStore,
+};
+use std::env;
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let token_store = TokenStore::load_from_file("tokens.json")?;
+    let xsts_token = token_store
+        .authorization_token
+        .ok_or(Error::GeneralError("No XSTS token was acquired".into()))?;
+    xsts_token.check_validity()?;
+    let auth_header = xsts_token.authorization_header_value();
+
+    let client = reqwest::Client::new();
+    for scid in env::args().skip(1) {
+        let mut out_items: Vec<serde_json::Value> = Vec::new();
+        let mut cont: Option<String> = None;
+        loop {
+            let mut url = format!(
+                "https://achievements.xboxlive.com/users/xuid({})/achievements/{}?orderBy=UnlockTime",
+                /* redacted account id, same length */ "XXXXXXXXXXXXXXXX", scid
+            );
+            if let Some(c) = &cont {
+                url.push_str(&format!("&continuationToken={}", urlquery::encode(c)));
+            }
+            let mut cv = CorrelationVector::new();
+            let mut signer = RequestSigner::new();
+            let resp = client
+                .get(&url)
+                .header("x-xbl-contract-version", "4")
+                .header("Accept-Language", "en-US")
+                .header("Authorization", &auth_header)
+                .add_cv(&mut cv)?
+                .sign(&mut signer, None)
+                .await?
+                .log()
+                .await?
+                .send()
+                .await?;
+            let status = resp.status();
+            let body = resp.text().await?;
+            if !status.is_success() {
+                eprintln!("HTTP {} for {}", status, url);
+                break;
+            }
+            let v: serde_json::Value = serde_json::from_str(&body)?;
+            let items = v["achievements"].as_array().cloned().unwrap_or_default();
+            let n = items.len();
+            out_items.extend(items);
+            cont = v["paging"]["continuationToken"].as_str().map(|s| s.to_string());
+            eprintln!("  {} items (total {}), cont={}", n, out_items.len(), cont.is_some());
+            if cont.is_none() || n == 0 {
+                break;
+            }
+        }
+        let fname = format!("ach-{}.json", scid);
+        std::fs::write(&fname, serde_json::to_vec_pretty(&out_items)?)?;
+        println!("{} -> {} achievements -> {}", scid, out_items.len(), fname);
+    }
+    Ok(())
+}
+
+mod urlquery {
+    pub fn encode(s: &str) -> String {
+        let mut out = String::new();
+        for b in s.bytes() {
+            match b {
+                b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'_' | b'.' | b'~' => out.push(b as char),
+                other => out.push_str(&format!("%{:02X}", other)),
+            }
+        }
+        out
+    }
+}
